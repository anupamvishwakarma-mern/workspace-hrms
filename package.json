{
  "name": "workforce-hrms",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Employee Attendance & HR Management SaaS",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @workforce/api dev",
    "dev:web": "pnpm --filter @workforce/web dev",
    "dev:marketing": "pnpm --filter @workforce/marketing dev",
    "dev:mobile": "pnpm --filter @workforce/mobile start",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "setup:env": "node scripts/setup-env.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
