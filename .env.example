# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
# directConnection=true lets a host machine reach a single-node replica set (needed for transactions).
MONGODB_URI=mongodb://localhost:27017/workforce_hrms?directConnection=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

WEB_APP_URL=http://localhost:3000
MOBILE_APP_SCHEME=workforcehrms
CORS_ORIGINS=http://localhost:3000

# Encrypts bank/statutory identifiers (PAN, Aadhaar, account numbers). 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK THIS UP: without it stored identifiers cannot be read. Unset = those endpoints answer 503.
FIELD_ENCRYPTION_KEY=

# Optional: background jobs (BullMQ). Unset = jobs disabled.
REDIS_URL=

# Optional: private object storage for employee documents (S3-compatible).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1
# Web build only: the storage origin the browser may upload to (CSP connect-src), e.g. https://s3.example.com
# STORAGE_ORIGIN=

# Optional: email (none | smtp). With "none", notifications are recorded, not delivered.
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional: push (none | expo)
PUSH_PROVIDER=none
EXPO_ACCESS_TOKEN=
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Raw GPS coordinates older than this many days are removed by the worker (min 7)
LOCATION_RETENTION_DAYS=90
# Punch proof photos are deleted from object storage after this many days (the punch is kept).
PHOTO_RETENTION_DAYS=90

# Optional: maps for the web admin (none | mapbox | google)
MAP_PROVIDER=none
MAP_API_KEY=

# Optional: billing (none | stripe). Core attendance never depends on this.
SUBSCRIPTION_PROVIDER=none
SUBSCRIPTION_API_KEY=

# Auth hardening (defaults shown)
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_SENSITIVE_MAX=10
INVITE_TTL_HOURS=72
RESET_TTL_MINUTES=60

# Serve /api/v1/docs/openapi.json? Defaults to true outside production and false in production.
# ENABLE_API_DOCS=false

# Local-disk storage for photos/documents (used when OBJECT_STORAGE_* is empty)
LOCAL_STORAGE_DIR=./uploads
# URL the phone/browser uses to reach this API (use your LAN IP for a real device)
PUBLIC_API_URL=http://localhost:4000

# ---- Dual database hosting (managed / customer-owned MongoDB) -------------------------------
# Key ring that encrypts customer connection strings (AES-256-GCM). "version:64-hex-chars", comma separated;
# the last (or TENANT_DB_ACTIVE_KEY_VERSION) encrypts new secrets, older ones stay readable until rotated.
# Generate one:  node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('hex'))"
# Without it the customer-owned option is switched off. KEEP IT OUT OF GIT; losing it makes stored strings unreadable.
# TENANT_DB_ENCRYPTION_KEYS=v1:<64 hex chars>
# TENANT_DB_ACTIVE_KEY_VERSION=v1
CUSTOMER_DB_ENABLED=true
MANAGED_CLUSTER_ID=primary
# Shown to managed companies in Settings -> Database & Infrastructure. Describe your REAL backup arrangement.
# MANAGED_BACKUP_POLICY_TEXT=
# Never true in production (the API refuses to start). Lets customer hosts be loopback/private and any port: dev/tests only.
CUSTOMER_DB_ALLOW_PRIVATE_HOSTS=false
CUSTOMER_DB_REQUIRE_TLS=true
CUSTOMER_DB_PORT_MIN=27000
CUSTOMER_DB_PORT_MAX=27999
CUSTOMER_DB_CONNECT_TIMEOUT_MS=8000
CUSTOMER_DB_MAX_POOL_SIZE=5
CUSTOMER_DB_IDLE_CLOSE_MINUTES=30
CUSTOMER_DB_MAX_CONNECTIONS=200
CUSTOMER_DB_MIN_MONGO_VERSION=6.0
CUSTOMER_DB_HEALTH_MIN_INTERVAL_SECONDS=240
RATE_LIMIT_DB_TEST_MAX=10
TENANT_DB_MIGRATION_BATCH=5
