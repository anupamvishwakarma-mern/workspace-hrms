# Marketing website (apps/marketing). Copy to .env.local. NEXT_PUBLIC_* values are visible in the browser: never put secrets in them.

# --- Deployment URLs ---
NEXT_PUBLIC_SITE_URL=http://localhost:3001        # public origin of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000         # the existing HRMS web app (Login link, activation hand-off)
# NEXT_PUBLIC_TRIAL_URL=/free-trial               # change to an external URL to send trial CTAs elsewhere
# NEXT_PUBLIC_DEMO_URL=/book-demo
# NEXT_PUBLIC_DOCS_URL=                           # empty = honest "not published yet" page
# NEXT_PUBLIC_HELP_URL=

# --- Server only (never exposed to the browser) ---
API_ORIGIN=http://localhost:4000                  # existing HRMS API. /free-trial calls POST {API_ORIGIN}/api/v1/signup
LEAD_WEBHOOK_URL=                                 # https endpoint that receives demo/contact/service/partner/newsletter leads
LEAD_WEBHOOK_SECRET=                              # optional: requests carry X-Signature-256 = sha256 HMAC of the body

# --- Brand (all optional; defaults live in src/config/brand.ts) ---
# NEXT_PUBLIC_BRAND_NAME=YOUR_HRMS
# NEXT_PUBLIC_BRAND_MARK=Y
# NEXT_PUBLIC_BRAND_LOGO=/logo.svg
# NEXT_PUBLIC_CONTACT_SALES_EMAIL=
# NEXT_PUBLIC_CONTACT_SUPPORT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_CONTACT_ADDRESS=
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_X=
# NEXT_PUBLIC_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_SOCIAL_GITHUB=

# --- Analytics (off unless configured AND the visitor accepts) ---
NEXT_PUBLIC_ANALYTICS_PROVIDER=none               # none | plausible | ga4
# NEXT_PUBLIC_ANALYTICS_ID=                       # plausible: your domain; ga4: G-XXXXXXXXXX
